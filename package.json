{
  "name": "@smoud/assets",
  "version": "1.0.0",
  "description": "One config. One command. All your game assets optimized. Image optimization, conversion, resizing, texture atlases, audio conversion, audio sprites, glTF model optimization and data minification for HTML5 games and playable ads.",
  "keywords": [
    "assets",
    "asset-pipeline",
    "images",
    "optimization",
    "compression",
    "webp",
    "png",
    "jpeg",
    "atlas",
    "texture-atlas",
    "spritesheet",
    "texturepacker",
    "audio",
    "mp3",
    "ogg",
    "audiosprite",
    "audio-sprite",
    "howler",
    "gltf",
    "glb",
    "3d",
    "models",
    "gltf-transform",
    "meshoptimizer",
    "sharp",
    "ffmpeg",
    "html5",
    "game",
    "game-development",
    "playable",
    "playable-ads",
    "cli"
  ],
  "homepage": "https://github.com/smoudjs/assets#readme",
  "bugs": {
    "url": "https://github.com/smoudjs/assets/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoudjs/assets.git"
  },
  "license": "MIT",
  "author": "Smoud",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "smoud-assets": "./dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test tests/",
    "sandbox": "node dist/cli.js build --config sandbox/assets.json --verbose",
    "sandbox:js": "node sandbox/assets.js",
    "deploy": "npm run build && npm run test && npm publish --access public"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@smoud/ffmpeg": "^1.0.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
