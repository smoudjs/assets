{
  "defaults": {
    "image": { "quality": 60, "maxWidth": 2048, "maxHeight": 2048 },
    "atlas": { "format": "webp", "quality": 60 },
    "audio": { "format": "mp3", "bitrate": 64, "channels": 1 },
    "gltf": { "normals": false, "textures": { "extract": true, "format": "webp", "quality": 60, "maxWidth": 2048, "maxHeight": 2048 } },
    "spine": { "format": "webp", "quality": 60, "maxWidth": 2048, "maxHeight": 2048 }
  },
  "actions": [
    "spine",
    { "action": "gltf", "source": { "when": { "triangles": ">50000" } }, "simplify": { "ratio": 0.5 } },
    "gltf",
    { "action": "image", "source": { "include": "*.png", "when": { "size": ">300kb" } }, "format": "webp", "quality": 45 },
    { "action": "image", "source": { "include": "*.png", "when": { "size": "<=300kb" } }, "format": "webp" },
    {
      "action": "image",
      "source": { "include": "#rest", "exclude": "*.svg", "when": { "size": ">300kb" } },
      "quality": 45
    },
    { "action": "image", "source": { "include": "#rest", "exclude": "*.svg" } },
    "audio",
    "json",
    "xml",
    { "action": "copy", "source": "#rest" }
  ]
}
