{
  "defaults": {
    "image": { "quality": 70, "maxWidth": 2048, "maxHeight": 2048 },
    "atlas": { "quality": 70 },
    "audio": { "format": "mp3", "bitrate": 96, "channels": 1 },
    "gltf": { "normals": false, "textures": { "extract": true, "quality": 70, "maxSize": 2048 } }
  },
  "actions": [
    "gltf",
    {
      "action": "image",
      "source": { "include": "*.png", "when": { "alpha": false, "size": ">400kb" } },
      "format": "jpeg",
      "quality": 50
    },
    {
      "action": "image",
      "source": { "include": "*.png", "when": { "alpha": false, "size": "<=400kb" } },
      "format": "jpeg"
    },
    {
      "action": "image",
      "source": { "include": "#rest", "exclude": "*.svg", "when": { "size": ">400kb" } },
      "quality": 50
    },
    { "action": "image", "source": { "include": "#rest", "exclude": "*.svg" } },
    "audio",
    "json",
    "xml",
    { "action": "copy", "source": "#rest" }
  ]
}
