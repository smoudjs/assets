{
  "source": "../tests/assets",
  "destination": "./compiled",
  "ignore": ["generate.mjs"],
  "actions": [
    { "action": "spine", "source": "spine", "format": "webp", "animations": { "exclude": ["debug/*"] } },
    "json",
    "xml",
    { "action": "atlas", "source": "sprites", "extrude": 1 },
    { "action": "atlas", "source": "tiles", "destination": "atlases", "trim": false, "extrude": 2, "powerOfTwo": true },
    { "action": "image", "source": "images/ui/icons", "format": "png", "density": 144, "destination": "#icons" },
    { "action": "atlas", "source": "#icons", "padding": 4 },
    {
      "action": "audio",
      "source": { "include": "audio/music", "when": { "duration": ">1" } },
      "format": "ogg",
      "quality": 70
    },
    { "action": "audiosprite", "source": "audio/sfx", "destination": "audio", "channels": 1, "quality": 60 },
    {
      "action": "audiosprite",
      "source": "audio/sfx",
      "destination": { "folder": "audio", "filename": "[name]-phaser[ext]" },
      "format": "ogg",
      "data": "phaser"
    },
    { "action": "gltf", "source": "models/crate", "format": "glb" },
    {
      "action": "gltf",
      "source": "models/crate.glb",
      "destination": "models/extracted",
      "normals": false,
      "vertexColors": false,
      "animations": false,
      "textures": { "extract": true, "format": "webp" }
    },
    {
      "action": "gltf",
      "source": "models/sphere.glb",
      "destination": { "folder": "models/lods", "filename": "[name]_lod0" }
    },
    {
      "action": "gltf",
      "source": "models/sphere.glb",
      "destination": { "folder": "models/lods", "filename": "[name]_lod1" },
      "simplify": { "ratio": 0.25 }
    },
    { "action": "gltf", "source": "models/crate.glb", "destination": "#compressed" },
    { "action": "meshopt", "source": "#compressed", "destination": "models/compressed" },
    {
      "action": "bitmapfont",
      "source": "fonts/NotoSans-Regular.ttf",
      "characters": "Play Again!",
      "size": 48,
      "outline": { "width": 3 },
      "shadow": { "x": 12, "y": 3 }
    },
    {
      "action": "bitmapfont",
      "source": "fonts/NotoSansCFF-Regular.otf",
      "destination": { "folder": "fonts", "filename": "score[ext]" },
      "characters": "0123456789",
      "size": 64,
      "color": "#ffd400",
      "outline": { "width": 4, "color": "#7a3b00" },
      "format": "webp",
      "data": "text"
    },
    { "action": "bitmapfont", "source": "fonts/NotoSans-Regular.ttf", "characters": "Play Again!0123456789", "destination": "#bitmap" },
    { "action": "bitmapfont", "source": "#bitmap", "characters": "0123456789", "destination": "fonts/digits" },
    { "action": "image", "source": "#rest" }
  ]
}
