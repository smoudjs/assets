{
  "source": "../tests/assets",
  "destination": "./compiled",
  "ignore": ["generate.mjs"],
  "actions": [
    "json",
    "xml",
    { "action": "atlas", "source": "sprites", "extrude": 1 },
    { "action": "atlas", "source": "tiles", "destination": "atlases", "trim": false, "extrude": 2, "powerOfTwo": true },
    { "action": "image", "source": "images/ui/icons", "format": "png", "density": 144, "destination": "#icons" },
    { "action": "atlas", "source": "#icons", "padding": 4 },
    { "action": "audio", "source": { "include": "audio/music", "when": { "duration": ">1" } }, "format": "ogg", "quality": 70 },
    { "action": "audiosprite", "source": "audio/sfx", "destination": "audio", "channels": 1, "quality": 60 },
    {
      "action": "audiosprite",
      "source": "audio/sfx",
      "destination": { "folder": "audio", "filename": "[name]-phaser[ext]" },
      "format": "ogg",
      "json": "phaser"
    },
    { "action": "image", "source": "#rest" },
    { "source": { "include": "spine", "exclude": ["*.json", "*.png"] }, "action": "copy" }
  ]
}
